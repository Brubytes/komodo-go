<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup/transfer rules.

  The app stores server names and base URLs in SharedPreferences and API
  credentials in Android Keystore-backed secure storage. None of this data
  should ever leave the device, so both cloud backup and device-to-device
  transfer are fully disabled. Note that android:allowBackup="false" alone
  does NOT disable device-to-device transfer on Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
